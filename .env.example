# Required before tenants can save encrypted provider credentials.
# Generate with: .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Production database location. The Docker deployment mounts this directory
# on persistent storage so workspaces and encrypted provider settings survive.
DATABASE_PATH=/app/database/smartmailer.sqlite3

# Public hostname used by the production HTTPS proxy.
APP_DOMAIN=sender.example.com
# Generate the password hash with the command documented in README.md.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD_HASH=
DASHBOARD_APP_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_SECONDS=28800

# Enables /v1/ai/generate-email. Keep this platform key server-side.
OPENAI_API_KEY=
# Defaults to gpt-5.6-luna if omitted.
OPENAI_MODEL=

# Use one configured provider only for legacy local endpoints.
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
SENDER_NAME=
SENDER_EMAIL=

# Durable transactional queue. Maximum 50 recipients per batch; interval minimum is 60 seconds.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
TRANSACTIONAL_BATCH_SIZE=50
TRANSACTIONAL_BATCH_INTERVAL_SECONDS=300
# Maximum recipients in one scheduled job. You may raise this to 100000 only
# after confirming your provider capacity and using a production-grade server.
TRANSACTIONAL_QUEUE_MAX_RECIPIENTS=10000
